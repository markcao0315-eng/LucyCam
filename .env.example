# Render sets PORT automatically. The server defaults to 10000 locally.
# This example file is documentation; the server does not load .env files.
NODE_ENV=production
PORT=10000
# Put actual credentials directly in Render Environment, never in Git.
GEMINI_API_KEY=
# Choose a private code of at least 12 characters; enter it on the phone.
LUCYCAM_ACCESS_CODE=
GEMINI_MODEL=gemini-3.1-flash-lite
# Attempt limits per single process; restart resets them, not a billing hard cap.
AI_DAILY_LIMIT=200
AI_HOURLY_LIMIT=60
# Experimental rear-camera guidance. Disabled unless explicitly set to true.
# Keep disabled in production until the iPhone acceptance checklist passes.
LIVE_GUIDANCE_ENABLED=false
# Optional OpenAI photo editing; add the secret only in Render Environment.
# A configured key enables automatic editing after an AI-guided shot.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
# Separate attempted-edit limits per process; no automatic retry.
RETOUCH_DAILY_LIMIT=20
RETOUCH_HOURLY_LIMIT=6
