# Render sets PORT automatically. The server defaults to 10000 locally.
# This example file is documentation; the server does not load .env files.
NODE_ENV=production
PORT=10000
# Put actual credentials directly in Render Environment, never in Git.
GEMINI_API_KEY=
# Choose a private code of at least 12 characters; enter it on the phone.
LUCYCAM_ACCESS_CODE=
GEMINI_MODEL=gemini-3.1-flash-lite
# Attempt limits per single process; restart resets them, not a billing hard cap.
AI_DAILY_LIMIT=200
AI_HOURLY_LIMIT=60
